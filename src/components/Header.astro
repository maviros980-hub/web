---
import { NAV, SITE_TITLE, url } from '../consts';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<header>
  <nav aria-label="Principal">
    <a class="brand" href={url('/')}>
      <span class="logo" aria-hidden="true">∫</span>{SITE_TITLE}
    </a>
    <ul>
      {NAV.filter((n) => n.href !== '/').map(({ href, label }) => (
        <li><a href={url(href)} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>
<style>
  header { background: var(--olive-deep); color: #f1f4ea; }
  nav { max-width: var(--wide); margin: 0 auto; padding: .85rem 1.25rem; display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: .55rem; font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; text-decoration: none; color: #fff; }
  .logo { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--ochre); color: #fff; font-family: var(--font-body); font-style: italic; font-size: 1.2rem; }
  ul { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  ul a { font-family: var(--font-head); font-weight: 500; text-decoration: none; color: #d6dfca; padding-bottom: 2px; border-bottom: 2px solid transparent; }
  ul a:hover { color: #fff; }
  ul a[aria-current='page'] { color: #fff; border-bottom-color: var(--ochre); }
</style>
