---
import { SITE_TITLE, DEPARTAMENTO } from '../consts';
---
<footer>
  <p><strong>{SITE_TITLE}</strong>, {DEPARTAMENTO}</p>
  <p>Torreperogil y Úbeda (Jaén), {new Date().getFullYear()}</p>
</footer>
<style>
  footer { border-top: 4px solid var(--ochre); background: var(--olive-deep); color: #c9d4bd; text-align: center; font-size: .9rem; padding: 1.75rem 1rem; }
  footer p { margin: .2rem 0; }
  footer strong { color: #fff; font-family: var(--font-head); }
</style>
