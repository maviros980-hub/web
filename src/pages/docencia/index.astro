---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { DEPARTAMENTO, url } from '../../consts';

const cursos = ['4º ESO Matemáticas B', '4º ESO Diversificación (ACT)', '2º Bach. Matemáticas CCSS II · PAU', 'Otros'] as const;
const materiales = (await getCollection('docencia')).sort((a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99) || b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Docencia" description="Materiales docentes del Departamento de Matemáticas del IES Gil de Zático.">
  <p class="dept">{DEPARTAMENTO}</p>
  <h1>Docencia</h1>
  <p>Relaciones de ejercicios, apuntes y recursos organizados por curso.</p>

  {cursos.map((curso) => {
    const lista = materiales.filter((m) => m.data.curso === curso);
    return lista.length > 0 && (
      <section>
        <h2>{curso}</h2>
        <ul class="cards">
          {lista.map((m) => (
            <li class="card" data-tono={curso.includes('PAU') ? 'azul' : curso.includes('Diversificación') ? 'ocre' : undefined}>
              <h3><a href={url(`/docencia/${m.id}/`)}>{m.data.title}</a></h3>
              <p>{m.data.description}</p>
              {(m.data.tipo || m.data.pdf) && <p>{m.data.tipo && <span class="tag">{m.data.tipo}</span>}{m.data.pdf && <a class="tag tag-pdf" href={url(m.data.pdf)} download>PDF</a>}</p>}
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</Base>
