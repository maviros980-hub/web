---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { DEPARTAMENTO, url } from '../consts';
import { CATEGORIAS, CURSOS, DESCARGAS } from '../data/descargas';

// Tamaño del PDF, calculado al publicar. Si el archivo no existe, la publicación falla
// para que no quede un enlace roto.
function tamano(archivo: string): string {
  const ruta = path.join(process.cwd(), 'public', archivo);
  if (!fs.existsSync(ruta)) {
    throw new Error(`Descargas: no existe el archivo ${archivo}. Cópialo a public/ o corrige la ruta en src/data/descargas.ts`);
  }
  const kb = fs.statSync(ruta).size / 1024;
  return kb >= 1024 ? `${(kb / 1024).toFixed(1).replace('.', ',')} MB` : `${Math.round(kb)} KB`;
}

const mes = (f: string) => new Date(f).toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });

const secciones = CATEGORIAS.map((cat) => ({
  ...cat,
  porCurso: CURSOS.map((curso) => ({
    curso,
    items: DESCARGAS
      .filter((d) => d.categoria === cat.id && d.curso === curso)
      .sort((a, b) => b.fecha.localeCompare(a.fecha))
      .map((d) => ({ ...d, peso: tamano(d.archivo) })),
  })).filter((g) => g.items.length > 0),
}));
---
<Base title="Descargas" description="PDF descargables: relaciones de ejercicios, exámenes y trabajos del Departamento de Matemáticas del IES Gil de Zático.">
  <p class="dept">{DEPARTAMENTO}</p>
  <h1>Descargas</h1>
  <p>Relaciones de ejercicios, exámenes y trabajos en PDF, para descargar e imprimir.</p>

  <nav class="saltos" aria-label="Ir a una categoría">
    {secciones.map((s) => <a class="salto" data-tono={s.tono} href={`#${s.id}`}>{s.nombre}</a>)}
  </nav>

  {secciones.map((s) => (
    <section id={s.id} data-tono={s.tono}>
      <h2>{s.nombre}</h2>
      <p class="muted">{s.descripcion}</p>

      {s.porCurso.length === 0 ? (
        <p class="vacio">Todavía no hay archivos en esta categoría.</p>
      ) : (
        s.porCurso.map((g) => (
          <div class="grupo">
            <h3>{g.curso}</h3>
            <ul class="lista">
              {g.items.map((d) => (
                <li class="fila">
                  <div class="info">
                    <p class="titulo">{d.titulo}</p>
                    {d.descripcion && <p class="desc">{d.descripcion}</p>}
                    <p class="meta">PDF · {d.peso} · <time datetime={d.fecha}>{mes(d.fecha)}</time></p>
                  </div>
                  <a class="btn" href={url(d.archivo)} download aria-label={`Descargar ${d.titulo} (PDF, ${d.peso})`}>Descargar</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      )}
    </section>
  ))}
</Base>

<style>
  section { --c: var(--olive); --c-soft: var(--olive-soft); scroll-margin-top: 1rem; }
  section[data-tono='azul'] { --c: var(--blue); --c-soft: var(--blue-soft); }
  section[data-tono='ocre'] { --c: var(--ochre); --c-soft: var(--ochre-soft); }

  .saltos { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.25rem 0 0; }
  .salto {
    --c: var(--olive); --c-soft: var(--olive-soft);
    font-family: var(--font-head); font-weight: 600; font-size: .95rem; text-decoration: none;
    background: var(--c-soft); color: var(--c); border-radius: 99px; padding: .3rem .9rem;
  }
  .salto[data-tono='azul'] { --c: var(--blue); --c-soft: var(--blue-soft); }
  .salto[data-tono='ocre'] { --c: var(--ochre); --c-soft: var(--ochre-soft); }
  .salto:hover { filter: brightness(.96); color: var(--c); }

  section h2 { border-left: 5px solid var(--c); padding-left: .7rem; margin-bottom: .4rem; }
  .muted { margin: 0 0 1rem; }
  .vacio { padding: .9rem 1rem; border: 1px dashed var(--line); border-radius: 8px; color: var(--muted); font-size: .97rem; margin: 0; }

  .grupo h3 { font-size: 1rem; color: var(--muted); font-weight: 600; margin: 1.5rem 0 .6rem; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .fila {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    background: var(--surface); border: 1px solid var(--line); border-left: 5px solid var(--c);
    border-radius: 4px 10px 10px 4px; padding: .8rem 1rem;
  }
  .info { min-width: 0; }
  .info p { margin: 0; }
  .titulo { font-family: var(--font-head); font-weight: 600; line-height: 1.3; }
  .desc { color: var(--muted); font-size: .94rem; line-height: 1.45; margin-top: .15rem !important; }
  .meta { color: var(--muted); font-family: var(--font-head); font-size: .8rem; margin-top: .3rem !important; }

  .btn {
    flex: none; font-family: var(--font-head); font-weight: 600; font-size: .95rem; text-decoration: none;
    background: var(--c); color: #fff; padding: .5rem 1rem; border-radius: 8px;
  }
  .btn:hover { background: var(--olive-deep); color: #fff; }
  @media (prefers-color-scheme: dark) { .btn { color: #10170f; } .btn:hover { color: #fff; } }
  @media (max-width: 34rem) {
    .fila { flex-direction: column; align-items: stretch; }
    .btn { text-align: center; }
  }
</style>
