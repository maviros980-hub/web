---
import Base from '../layouts/Base.astro';

// Añade aquí tus proyectos. "url" y "repo" son opcionales.
const proyectos = [
  {
    nombre: 'Generador de exámenes PAU · Matemáticas CCSS II',
    descripcion: 'Aplicación para generar y corregir exámenes tipo PAU Andalucía a partir de un banco de ejercicios.',
    tags: ['Docencia', 'App web'],
    url: '',
    repo: '',
  },
  {
    nombre: 'Checklists de fin de curso',
    descripcion: 'Listas de comprobación interactivas para las tareas administrativas de final de curso.',
    tags: ['HTML', 'Gestión'],
    url: '',
    repo: '',
  },
];
---
<Base title="Proyectos" description="Proyectos de programación y tecnología.">
  <h1>Proyectos</h1>
  <p>Herramientas y experimentos de programación, muchos pensados para el aula.</p>
  <ul class="cards">
    {proyectos.map((p) => (
      <li class="card">
        <h3>{p.url ? <a href={p.url}>{p.nombre}</a> : p.nombre}</h3>
        <p>{p.descripcion}</p>
        <p>{p.tags.map((t) => <span class="tag">{t}</span>)}</p>
        {p.repo && <p><a href={p.repo}>Código</a></p>}
      </li>
    ))}
  </ul>
</Base>
